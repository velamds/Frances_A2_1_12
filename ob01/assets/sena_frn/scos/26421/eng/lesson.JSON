ts": {"content": ".", "type": ""}}, {"content": "secondary_1", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "r\u00e9put\u00e9", "type": "text"}], "correct": 1}]}, {"id": 5, "_data": [{"type": "question", "contents": [{"content": "<span class=\"run-on-question\"></span>Ils veulent que j'", "type": "text"}]}, {"type": "post_question", "contents": {"content": "de l'exp\u00e9rience de travail dans la cuisine. ", "type": ""}}, {"content": "secondary_1", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "acqui\u00e8re ", "type": "text"}], "correct": 1}]}], "template_override": 2}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "stimuli": [{"template_override": 1, "id": 0, "type": "welcome", "_data": [], "contents": [{}]}, {"id": 1, "type": "audio", "_data": [], "template_override": 1, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "frn4le12ob01re2aud01", "coverimg": "frn4le12ob01re2img05.jpg", "images": [{"id": 0, "text": "", "image": "frn4le12ob01re2img05.jpg", "time": "0"}, {"id": 1, "text": "<span class = \"strong\">Coraline</span> : Pierre, comment vas-tu ?</br>\n<span class=\"strong\">Pierre </span> : Mon travail est stressant en ce moment. J'ai beaucoup d'\u00e9ch\u00e9ances \u00e0 respecter.<br/>\n<span class=\"strong\">Coraline</span> : Vas-y mollo !  J'esp\u00e8re que tu n'en fais pas trop. <br/>\n<span class=\"strong\">Pierre </span> : Non, non... Heureusement, mon patron est de caract\u00e8re facile. Et de ton c\u00f4t\u00e9, comment \u00e7a se passe ton boulot ?<br/>", "image": "frn4le12ob01re2img05.jpg", "time": "100"}, {"id": 2, "text": "<span class=\"strong\">Coraline</span> : Je suis tr\u00e8s prise avec mes cours. Ils veulent que j'acqui\u00e8re l'exp\u00e9rience en cuisine. Je vais commencer \u00e0 envoyer des demandes d'emploi.<br/><span class=\"strong\">Pierre </span> : Pour quel restaurant veux-tu travailler ?<br/>\n<span class=\"strong\">Coraline</span> : Il y a un poste \u00e0 pourvoir dans un super resto pas loin. Le chef est r\u00e9put\u00e9.<br/>", "image": "frn4le12ob01re2img05.jpg", "time": "17250"}, {"id": 3, "text": "<span class=\"strong\">Pierre </span> : Ce serait une bonne opportunit\u00e9 pour perfectionner tes connaissances !<br/>\n<span class=\"strong\">Coraline</span> : Exactement... Je veux m'exercer \u00e0  mon m\u00e9tier autant que possible.<br/>\n<span class=\"strong\">Pierre </span> : Alors envoie ta demande d\u00e8s que possible ! J'esp\u00e8re que \u00e7a va marcher. Tu dois croire que tu es aussi bonne que les autres !<br/><span class=\"strong\">Coraline</span> : Merci !<br/>\n<span class=\"strong\">Pierre </span> : Peut-\u00eatre que tu pourrais ouvrir ton propre restaurant ici ! <br/>", "image": "frn4le12ob01re2img01.jpg", "time": "32000"}]}}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"content": "Le travail \u00e0 mi-temps de Coraline", "type": "lesson_name"}, {"content": "Une opportunit\u00e9 de travail", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "scholar > Achievement Test > Achievement Test", "type": "origin"}, {"content": 12, "type": "lesson"}, {"content": "A2.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "L'apprenant fait usage des informations concernant des projets personnels et professionnels futurs, dans des situations sociales et de travail.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}]}, {"content": "frn4le12ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Exprimer l'int\u00e9r\u00eat, l'inqui\u00e9tude et l'espoir "}, {"type": "describer", "content": "Vous pouvez montrer combien le bien-\u00eatre de quelqu'un vous tient \u00e0 c\u0153ur en utilisant la structure : <span class=\"strong\"><span class=\"italic\">J'esp\u00e8re que</span> + le verbe au pr\u00e9sent/au futur simple</span>."}, {"type": "example", "content": "J'esp\u00e8re que \u00e7a va marcher."}, {"type": "example", "content": "J'esp\u00e8re que tu n'en fais pas trop."}, {"type": "example", "content": "J'esp\u00e8re que tout ira bien. "}]}, {"type": "target_word", "contents": [{"content": "l'\u00e9ch\u00e9ance", "type": "name"}, {"content": "date qui marque la fin de quelque chose", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : J'ai beaucoup d'\u00e9ch\u00e9ances \u00e0 respecter.", "type": "example"}, {"content": "frn4le12ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots qu'on utilise quand on cherche un boulot.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "pris, prise", "type": "name"}, {"content": "avoir son temps occup\u00e9", "type": "definition"}, {"content": "(adjectif)", "type": "part_speech"}, {"content": "Exemple : Je suis tr\u00e8s prise avec mes cours.", "type": "example"}, {"content": "frn4le12ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "acqu\u00e9rir", "type": "name"}, {"content": "prendre, obtenir", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Ils veulent que j'acqui\u00e8re de l'exp\u00e9rience de travail dans la cuisine. ", "type": "example"}, {"content": "frn4le12ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "demande d'emploi", "type": "name"}, {"content": "une  candidature pour un travail", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Je vais commencer \u00e0 envoyer des demandes d'emploi.", "type": "example"}, {"content": "frn4le12ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "r\u00e9put\u00e9, r\u00e9put\u00e9e", "type": "name"}, {"content": "\u00eatre connu", "type": "definition"}, {"content": "(adjectif)", "type": "part_speech"}, {"content": "Exemple : Le chef de ce restaurant est r\u00e9put\u00e9. ", "type": "example"}, {"content": "frn4le12ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "perfectionner", "type": "name"}, {"content": "affiner, am\u00e9liorer", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Ce serait une bonne opportunit\u00e9 pour perfectionner tes connaissances !", "type": "example"}, {"content": "frn4le12ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "exercer", "type": "name"}, {"content": "pratiquer, faire", "type": "definition"}, {"content": "(verbe)", "type": "part_speech"}, {"content": "Exemple : Je veux m'exercer \u00e0 mon m\u00e9tier autant que possible.", "type": "example"}, {"content": "frn4le12ob01aud07", "type": "audio"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Exprimer le rapport d'\u00e9galit\u00e9"}, {"type": "describer", "content": "Vous pouvez exprimer le rapport d'\u00e9galit\u00e9 entre deux choses, personnes, actions, etc. en utilisant les locutions : <span class=\"italic\">aussi ... que</span> et <span class=\"italic\">autant que</span>. "}, {"type": "text", "content": "On utilise <span class=\"italic\">aussi... que</span> quand le rapport d'\u00e9galit\u00e9 porte sur un adjectif, un participe pass\u00e9 ou un adverbe. <br/><span class=\"italic\">Aussi</span> se place devant l'adjectif ou l'adverbe qui fait l'objet du rapport d'\u00e9galit\u00e9."}, {"type": "text", "content": "Exemple : <span class=\"italic\">Tu dois croire que tu es <span class=\"strong\">aussi</span> bonne <span class=\"strong\">que</span> les autres !</span>"}, {"type": "text", "content": "On utilise <span class=\"italic\">autant... que</span> quand le rapport d'\u00e9galit\u00e9 porte sur un verbe. On peut \u00e9galement utiliser la locution avec un adjectif ou un adverbe. Dans ce cas, l'expression <span class=\"italic\">autant que</span> se place apr\u00e8s l'adjectif ou l'adverbe. "}, {"type": "text", "content": "Exemples : <br/><span class=\"italic\">Je veux m'exercer <span class=\"strong\">autant que</span> possible \u00e0 mon m\u00e9tier.<br/>Je travaille <span class=\"strong\">autant que</span> toi. <br/>Elle est gentille <span class=\"strong\">autant</span> que jolie.</span>"}, {"type": "text", "content": "<span class=\"strong\">Note : Compl\u00e9ter un formulaire avec de l'information simple et quotidienne : </span></br> Il existe g\u00e9n\u00e9ralement deux fa\u00e7ons de remplir des formulaires : formulaire papier et formulaire en ligne. C'est-\u00e0-dire que vous pouvez pr\u00e9senter un formulaire de demande ou contact sous la forme de papier ou sur Internet. Lorsque vous remplissez un formulaire, vous devez :</br> -\tR\u00e9pondre \u00e0 chaque question.</br> -\tSi vous n'avez pas de r\u00e9ponse \u00e0 une question, vous pouvez inscrire \u00ab sans objet \u00bb ou \u00ab S.O. \u00bb dans l'espace pr\u00e9vu \u00e0 cet effet.</br> -\tSi n\u00e9cessaire ajoutez l'indicatif t\u00e9l\u00e9phonique \u00e0 votre num\u00e9ro de t\u00e9l\u00e9phone."}]}, {"type": "target_word", "contents": [{"content": "n'en fais pas trop ", "type": "name"}, {"content": "conseil de mod\u00e9ration donn\u00e9 \u00e0 quelqu'un qui semble d\u00e9bord\u00e9", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Exemple : Tu sembles stress\u00e9e... N'en fais pas trop&nbsp;!", "type": "example"}, {"content": "frn4le12ob01aud08", "type": "audio"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "Je parle du travail de mes r\u00eaves."}, {"type": "text", "content": "Je d\u00e9cris un travail."}, {"type": "text", "content": "Je parle de mon domaine professionnel."}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Pensez \u00e0 votre emploi id\u00e9al. De quel type d'emploi s'agit-il ?"}, {"type": "text", "content": " Allez sur internet et faites des recherches."}, {"type": "text", "content": "\u00c9crivez un paragraphe (8 \u00e0 10 phrases) d\u00e9crivant le travail. "}, {"type": "text", "content": "Donnez les raisons pour lesquelles vous voulez ce travail."}, {"type": "text", "content": "Lisez votre  paragraphe \u00e0 votre camarade."}, {"type": "text", "content": " \u00c9coutez le paragraphe  de votre camarade et \u00e9changez vos id\u00e9es."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Note professionnelle"}, {"type": "describer", "content": "Lorsque vous remplissez un formulaire, vous devez fournir quelques informations. Voici une liste (non exhaustive) de ce que l'on peut vous demander : "}, {"type": "table", "content": "{\"rows\":10,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Madame/Monsieur\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous devez indiquer votre titre de civilit\u00e9. Depuis 2012, le titre <span class=\\\"italic\\\">Mademoiselle</span> a \u00e9t\u00e9 supprim\u00e9 des formulaires\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Nom de famille \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous devez indiquer votre nom de naissance. C'est celui transmis par vos parents biologiques ou adoptifs\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Nom d'usage s'il y a lieu\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"nom que vous utilisez au quotidien. Cela peut \u00eatre le nom de votre conjoint, de votre ex-conjoint, de votre p\u00e8re ou de votre m\u00e8re\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Pr\u00e9noms\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous devez inscrire vos pr\u00e9noms dans l'ordre indiqu\u00e9 sur vos papiers officiels (carte d'identit\u00e9, passeport)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Date de naissance\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"date \u00e0 laquelle vous \u00eates n\u00e9\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Pays de naissance\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"le pays o\u00f9 vous \u00eates n\u00e9\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Nationalit\u00e9 \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"vous devez indiquer si vous \u00eates de nationalit\u00e9 fran\u00e7aise, europ\u00e9enne (EEE) ou d'une nationalit\u00e9 autre\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Adresse\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"si vous habitez \u00e0 Paris, Lyon ou Marseille, on vous demande de pr\u00e9ciser l'arrondissement*\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "text", "content": "* Un arrondissement est le d\u00e9coupage administratif d'une ville. Chaque arrondissement dispose de sa mairie. "}]}]}